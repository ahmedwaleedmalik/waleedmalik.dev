---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: Array<{ text: string; slug: string }>;
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, canonical } = post.data;
const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const url = canonical ?? new URL(`/blog/${post.id}/`, SITE.url).href;
const isFeature = post.data.presentation === 'feature';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  url,
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
};
---

<Base title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />
  {
    isFeature ? (
      <article class="feature-post">
        <header class="feature-masthead">
          <p class="feature-kicker">Feature essay</p>
          <h1>{title}</h1>
          <p class="feature-subtitle">{description}</p>
          <div class="feature-meta">
            <span>{dateStr}</span>
            <span>LLM infrastructure</span>
            <span>Platform engineering</span>
          </div>
        </header>
        <div class="feature-layout">
          <div class="prose feature-prose">
            <slot />
          </div>
          {headings.length > 0 && (
            <aside class="feature-toc" aria-label="Article sections">
              <strong>Sections</strong>
              {headings.map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
            </aside>
          )}
        </div>
      </article>
    ) : (
      <article>
        <p class="eyebrow">{dateStr}</p>
        <h1>{title}</h1>
        <p class="muted">{description}</p>
        <hr />
        <div class="prose">
          <slot />
        </div>
      </article>
    )
  }
  <p class={isFeature ? 'feature-back' : ''} style="margin-top:3em"><a class="linked" href="/blog">← all writing</a></p>
</Base>
